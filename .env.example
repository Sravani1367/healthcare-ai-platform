APP_ENV=development
DATABASE_URL=sqlite:///./healthcare_v2.db
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=28800
MOCK_EHR_URL=http://127.0.0.1:8001
ALLOW_DEMO_SEED=true

# Resend transactional email. When omitted, delivery is safely simulated.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Healthcare Platform <onboarding@resend.dev>

# Provider-neutral telephone webhook configuration.
TELEPHONE_PROVIDER=webhook
TELEPHONE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# UI server-to-server and browser-to-API addresses may differ in containers.
API_BASE_URL=http://127.0.0.1:8000/api/v1
BROWSER_API_BASE_URL=http://127.0.0.1:8000/api/v1
